# Credenciales de MySQL para restore_db.sh
# ──────────────────────────────────────────
# Usuario de MySQL (default: remote)
MYSQL_USER=remote
MYSQL_PASS=admin # Si se deja vacío, el script la solicitará de forma interactiva.

# Carpeta de backups para el menú interactivo.
# Puede ser relativa al script (ej: backups) o absoluta (ej: /mnt/nas/db_backups).
# Default: backups/  (se crea junto al script)
BACKUPS_DIR=backups